# URL pública do backend em produção (ex.: https://seu-backend.onrender.com)
# Configure essa variável no painel do Vercel, em Settings > Environment Variables.
VITE_API_BASE_URL=

# URL do Webhook do n8n que atende o Assistente (node Webhook, publicado)
VITE_ASSISTENTE_WEBHOOK_URL=
# Valor do header configurado na credential de Header Auth do node Webhook
VITE_ASSISTENTE_WEBHOOK_SECRET=
